meta {
  name: Create Transaction
  type: http
  seq: 1
}

post {
  url: {{payment_service_url}}/api/v1/payments/transactions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{auth_token}}
}

body:json {
  {
    "enrollment_id": 1,
    "amount": 1500000,
    "payment_method": "bank_transfer",
    "user_id": "{{user_id}}"
  }
}
