meta {
  name: Create User
  type: http
  seq: 1
}

post {
  url: {{user_service_url}}/api/v1/users/new
  body: json
  auth: bearer
}

auth:bearer {
  token: {{auth_token}}
}

body:json {
  {
    "name": "New User",
    "email": "newuser@example.com",
    "password": "password123",
    "phone": "081234567890",
    "role": "member"
  }
}
