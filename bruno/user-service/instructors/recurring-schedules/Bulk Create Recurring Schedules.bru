meta {
  name: Bulk Create Recurring Schedules
  type: http
  seq: 1
}

post {
  url: {{user_service_url}}/api/v1/instructors/:id/recurring-schedules/bulk
  body: json
  auth: bearer
}

auth:bearer {
  token: {{auth_token}}
}

params:path {
  id: {{instructor_id}}
}

body:json {
  {
    "schedules": [
      { "day_of_week": 1, "start_time": "09:00", "end_time": "17:00" },
      { "day_of_week": 3, "start_time": "09:00", "end_time": "17:00" }
    ]
  }
}
