meta {
  name: Create Instructor Profile
  type: http
  seq: 1
}

post {
  url: {{user_service_url}}/api/v1/instructors/new
  body: json
  auth: bearer
}

auth:bearer {
  token: {{auth_token}}
}

body:json {
  {
    "user_id": "{{user_id}}",
    "bio": "Experienced driving instructor",
    "license_number": "SIM-001"
  }
}
