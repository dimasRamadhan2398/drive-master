meta {
  name: Create Schedule
  type: http
  seq: 4
}

post {
  url: {{booking_service_url}}/api/v1/schedules/create
  body: json
  auth: bearer
}

auth:bearer {
  token: {{auth_token}}
}

body:json {
  {
    "instructor_id": "{{instructor_id}}",
    "date": "2024-07-25",
    "start_time": "09:00",
    "end_time": "17:00",
    "max_slots": 5
  }
}
