meta {
  name: Create Enrollment
  type: http
  seq: 2
}

post {
  url: {{booking_service_url}}/api/v1/enrollments
  body: json
  auth: bearer
}

auth:bearer {
  token: {{auth_token}}
}

body:json {
  {
    "user_id": "{{user_id}}",
    "package_id": 1,
    "instructor_id": "{{instructor_id}}",
    "addon_ids": []
  }
}
