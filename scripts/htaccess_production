# --- DriveMaster Reverse Proxy Configuration ---

# Prevent Apache from serving directory listings or index.php by default
DirectoryIndex disabled

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Exclude AutoSSL ACME challenge from proxying (keeps SSL auto-renew working)
    RewriteCond %{REQUEST_URI} ^/\.well-known/acme-challenge [NC]
    RewriteRule .* - [L]

    # 2. Proxy API requests to appropriate microservices

    # User Service (port 8001)
    RewriteRule ^api/v1/(auth|users|members|instructors|testimonials|entitlements|certificates)(/.*)?$ http://127.0.0.1:8001/api/v1/$1$2 [P,L]
    RewriteRule ^api/v1/dashboard/certifications(/.*)?$ http://127.0.0.1:8001/api/v1/dashboard/certifications$1 [P,L]

    # Core Service (port 8002)
    RewriteRule ^api/v1/(cars|packages|addons|articles|regions|general-settings)(/.*)?$ http://127.0.0.1:8002/api/v1/$1$2 [P,L]
    RewriteRule ^api/v1/admin/(sales|analytics)(/.*)?$ http://127.0.0.1:8002/api/v1/admin/$1$2 [P,L]

    # Booking Service (port 8003)
    RewriteRule ^api/v1/(bookings|certifications|schedules|sessions|enrollments)(/.*)?$ http://127.0.0.1:8003/api/v1/$1$2 [P,L]

    # Payment Service (port 8004)
    RewriteRule ^api/v1/(transactions|payments)(/.*)?$ http://127.0.0.1:8004/api/v1/$1$2 [P,L]
    RewriteRule ^notifications(/.*)?$ http://127.0.0.1:8004/notifications$1 [P,L]

    # 3. Proxy ALL other traffic unconditionally to Nuxt frontend (port 3000)
    #    Note: No !-f / !-d conditions — we always want Nuxt to handle routing,
    #    not Apache's directory/file index fallback.
    RewriteCond %{REQUEST_URI} !^/\.well-known
    RewriteCond %{REQUEST_URI} !^/cgi-bin
    RewriteRule ^(.*)$ http://127.0.0.1:3000/$1 [P,L]
</IfModule>
