# --- DriveMaster Dev API Subdomain Reverse Proxy Configuration ---

# Prevent Apache from serving directory listings or index.php by default
DirectoryIndex disabled

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Exclude AutoSSL ACME challenge from proxying (keeps SSL auto-renew working)
    RewriteCond %{REQUEST_URI} ^/\.well-known/acme-challenge [NC]
    RewriteRule .* - [L]

    # 2. Proxy API requests to appropriate dev microservices

    # Dev User Service (port 9001)
    RewriteRule ^api/v1/(auth|users|members|instructors|testimonials|entitlements|certificates)(/.*)?$ http://127.0.0.1:9001/api/v1/$1$2 [P,L]
    RewriteRule ^api/v1/dashboard/certifications(/.*)?$ http://127.0.0.1:9001/api/v1/dashboard/certifications$1 [P,L]

    # Dev Core Service (port 9002)
    RewriteRule ^api/v1/(cars|packages|addons|articles|regions|general-settings)(/.*)?$ http://127.0.0.1:9002/api/v1/$1$2 [P,L]
    RewriteRule ^api/v1/admin/(sales|analytics)(/.*)?$ http://127.0.0.1:9002/api/v1/admin/$1$2 [P,L]

    # Dev Booking Service (port 9003)
    RewriteRule ^api/v1/(bookings|certifications|schedules|sessions|enrollments)(/.*)?$ http://127.0.0.1:9003/api/v1/$1$2 [P,L]

    # Dev Payment Service (port 9004)
    RewriteRule ^api/v1/(transactions|payments)(/.*)?$ http://127.0.0.1:9004/api/v1/$1$2 [P,L]
    RewriteRule ^notifications(/.*)?$ http://127.0.0.1:9004/notifications$1 [P,L]
</IfModule>
